ServiceBinary=%13%\gpdtumdf.dll
[DriverCopy]
gpdtumdf.dll
[Strings]
Provider="gpdt local development"
Disk="gpdt UMDF brightness filter"
Up="gpdt UMDF: GPD brightness up"
Down="gpdt UMDF: GPD brightness down"
